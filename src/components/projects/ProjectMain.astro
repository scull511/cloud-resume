---
import Project from "../Project.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import "../../styles/projects.css";

const allProjects: CollectionEntry<"project">[] =
  await getCollection("project");
---

<div id="projects-container-content">
  <div class="section">
    <div class="title-btn-row">
      <h2>Projects</h2>
      <a href="/" class="btn">Home</a>
    </div>
    <h4 class="no-margin-top-h4">Cloud Projects</h4>
    <div class="projects-container">
      {
        allProjects.map((project) =>
          project.data.visible ? <Project project={project} /> : null
        )
      }
    </div>
    <h4 class="margin-top-h4">Other</h4>
  </div>

  <style>
    .projects-section {
      grid-row: 2;
      grid-column: 1;
      border-bottom: 1px solid var(--body);
    }

    .projects-container {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      align-content: center;
      gap: 20px;
    }

    #projects-container-content {
      display: grid;
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
      gap: var(--spacing);
    }

    a {
      text-decoration: none;
    }

    .no-margin-top-h4,
    .margin-top-h4 {
      font-weight: 300;
    }

    .no-margin-top-h4 {
      margin-top: 0;
      margin-bottom: 5px;
    }
  </style>
</div>
