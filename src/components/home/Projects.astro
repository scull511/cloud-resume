---
import Project from "../Project.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const allProjects: CollectionEntry<"project">[] =
  await getCollection("project");
---

<div class="projects-section section">
  <div class="title-btn-row">
    <h2>Projects</h2>
    <a href="./projects" class="btn">Projects</a>
  </div>
  <h4 id="no-margin-top-h4">Cloud Projects</h4>
  <div class="projects-container">
    {
      allProjects.map((project) =>
        project.data.homepage ? <Project project={project} /> : null
      )
    }
  </div>
  <h4 id="margin-top-h4">Other</h4>
</div>

<style>
  .projects-section {
    grid-row: 2;
    grid-column: 1;
    border-bottom: 1px solid var(--body);
  }

  .projects-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    align-content: center;
    gap: 20px;
  }

  #no-margin-top-h4 {
    font-weight: 300;
    margin-top: 10px;
    margin-bottom: 5px;
  }

  #margin-top-h4 {
    font-weight: 300;
    margin-top: 20px;
    margin-bottom: 5px;
  }
</style>
